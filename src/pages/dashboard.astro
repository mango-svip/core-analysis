---
import Layout from "../layouts/Layout.astro";
import { supabase } from "../db/supabase";

// 获取URL中的日期参数，如果没有则使用当前日期
const requestUrl = new URL(Astro.request.url);
const date = requestUrl.searchParams.get('date') || new Date().toISOString().split('T')[0];

const allPlates = new Set();
const allPlatesCounter = new Map();
const excludedPlates = new Set();
excludedPlates.add('ST股');
excludedPlates.add('强势人气股');
excludedPlates.add('复牌股');

const selectedPlate = requestUrl.searchParams.get('plate') || '';

async function fetchStockData(date, selectedPlate) {
  const query = supabase
    .from('stocks')
    .select('*')
    .eq('date', date);
  if (selectedPlate) {
    query.like('plates', '%' + selectedPlate + '%');
  }
  const { data, error } = await query;
  if (error) console.error('Error fetching data:', error);
  return ((data || []).filter(r => {
    if (!r.plates) return true;
    const arr = r.plates.split(',').map(p => p.trim());
    return !arr.some(p => excludedPlates.has(p));
  }));
}

const stocks = await fetchStockData(date, selectedPlate);

// limit_up_days 为字符串标签（"首板"/"2连板"/"3连板"...），解析为板数
const toDays = (v) => {
  const s = String(v ?? '').trim();
  const m = s.match(/\d+/);
  return m ? parseInt(m[0], 10) : 1;
};

stocks.forEach(stock => {
  if (stock.plates) {
    stock.plates.split(',').forEach(plate => {
      if (!excludedPlates.has(plate.trim())) {
        allPlates.add(plate.trim());
        allPlatesCounter.set(plate.trim(), (allPlatesCounter.get(plate.trim()) || 0) + 1);
      }
    });
  }
});
const platesList = Array.from(allPlates).sort((a, b) => allPlatesCounter.get(b) - allPlatesCounter.get(a));
const hotPlate = platesList[0] || '无';
const hotPlateCount = platesList.length ? allPlatesCounter.get(hotPlate) : 0;

// ==================== 核心统计 ====================
const totalCount = stocks.length;
const avgChange = totalCount
  ? (stocks.reduce((s, x) => s + (Number(x.change_percent) || 0), 0) / totalCount).toFixed(2)
  : '0.00';

let maxLimitUp = 0, lianbanCount = 0, shoubanCount = 0, highCount = 0;
let breakTotal = 0, breakCount = 0, sealCount = 0;
const ladder = [0, 0, 0, 0, 0]; // 首板/2/3/4/5板+
stocks.forEach(s => {
  const days = toDays(s.limit_up_days);
  if (days > maxLimitUp) maxLimitUp = days;
  if (days >= 1) ladder[Math.min(days - 1, 4)]++;
  if (days >= 2) lianbanCount++; else shoubanCount++;
  if (days >= 3) highCount++;
  const b = s.break_limit_up_times;
  if (b != null && b !== '') { breakTotal += Number(b) || 0; breakCount++; if ((Number(b) || 0) === 0) sealCount++; }
});
const avgBreak = breakCount ? (breakTotal / breakCount).toFixed(2) : '0.00';
const avgDays = totalCount ? (stocks.reduce((a, s) => a + toDays(s.limit_up_days), 0) / totalCount).toFixed(2) : '0.00';

// 情绪指标
const lianbanRate = totalCount ? ((lianbanCount / totalCount) * 100).toFixed(1) : '0.0';
const sealRate = totalCount ? ((sealCount / totalCount) * 100).toFixed(1) : '0.0';
let earlySeal = 0;
stocks.forEach(s => { if (s.first_limit_up && s.first_limit_up <= '10:00') earlySeal++; });
const earlyRate = totalCount ? ((earlySeal / totalCount) * 100).toFixed(1) : '0.0';

// 连板晋级率（n板 -> n+1板 = count(n+1)/count(n)）
const c1 = ladder[0], c2 = ladder[1], c3 = ladder[2], c4 = ladder[3], c5 = ladder[4];
const r12 = c1 ? (c2 / c1 * 100).toFixed(1) : '0.0';
const r23 = c2 ? (c3 / c2 * 100).toFixed(1) : '0.0';
const r34 = c3 ? (c4 / c3 * 100).toFixed(1) : '0.0';
const r45 = c4 ? (c5 / c4 * 100).toFixed(1) : '0.0';

// 最高连板代表股
const topStocks = stocks.filter(s => toDays(s.limit_up_days) === maxLimitUp).map(s => s.stock_name);
const topStocksStr = topStocks.slice(0, 3).join('、');

// 板块深度分析（Top 12）: 家数 / 最高连板 / 平均连板 / 平均涨幅 / 龙头股
const plateDetail = platesList.slice(0, 12).map(plate => {
  const ps = stocks.filter(s => (s.plates || '').split(',').map(p => p.trim()).includes(plate));
  const count = ps.length;
  const maxD = Math.max(0, ...ps.map(s => toDays(s.limit_up_days)));
  const sumDays = ps.reduce((a, s) => a + toDays(s.limit_up_days), 0);
  const sumChange = ps.reduce((a, s) => a + (Number(s.change_percent) || 0), 0);
  const leaders = ps.filter(s => toDays(s.limit_up_days) === maxD).map(s => s.stock_name).slice(0, 2);
  return {
    plate,
    count,
    maxD,
    avgDays: (sumDays / count).toFixed(1),
    avgChange: (sumChange / count).toFixed(1),
    leader: leaders.join(' / ') || '—',
  };
}).sort((a, b) => b.count - a.count);

// 数据洞察
const insights = [];
insights.push(`今日共 <b>${totalCount}</b> 只个股涨停，平均涨幅 <b>${avgChange}%</b>，市场最高连板 <b>${maxLimitUp} 板</b>${maxLimitUp > 0 && topStocksStr ? `（代表：${topStocksStr}）` : ''}。`);
if (hotPlate !== '无') insights.push(`最热板块为「<b>${hotPlate}</b>」，共 <b>${hotPlateCount}</b> 只涨停，资金主攻方向明确。`);
insights.push(`连板晋级率 <b>${lianbanRate}%</b>，其中 3板及以上高位股 <b>${highCount}</b> 只，赚钱效应${lianbanCount > 0 ? '尚可' : '偏弱'}。`);
const avgBreakNum = Number(avgBreak);
insights.push(avgBreakNum <= 0.5 ? `平均炸板 <b>${avgBreak}</b> 次，封板情绪偏强，高位股断板确定性较高。`
  : avgBreakNum <= 1.5 ? `平均炸板 <b>${avgBreak}</b> 次，封板情绪中性，注意龙头分歧。`
  : `平均炸板 <b>${avgBreak}</b> 次，开板频繁、封板情绪偏弱，需警惕高位回落。`);
const earlyN = Number(earlyRate);
insights.push(earlyN >= 60 ? `早盘（10:00 前）封板占比 <b>${earlyRate}%</b>，资金抢筹意愿强、情绪亢奋。`
  : earlyN >= 40 ? `早盘封板占比 <b>${earlyRate}%</b>，节奏相对平稳，以题材驱动为主。`
  : `早盘封板占比 <b>${earlyRate}%</b>，多为盘中/尾盘拉升，题材持续性需观察。`);
---

<Layout title="股票数据分析看板">
  <div class="min-h-screen bg-[#f4f6fa] text-gray-800">
    <!-- 顶栏导航 -->
    <header class="sticky top-0 z-30 bg-white/80 backdrop-blur-md border-b border-gray-200/70 shadow-sm">
      <div class="max-w-7xl mx-auto px-4 py-3 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#ff4d4f] to-[#ff9c40] flex items-center justify-center shadow-md shrink-0">
            <i class="ri-funds-line text-white text-xl"></i>
          </div>
          <div>
            <h1 class="text-xl font-bold text-gray-900 leading-tight">股票数据分析看板</h1>
            <p class="text-xs text-gray-500 flex items-center gap-1"><i class="ri-global-line text-[11px]"></i>涨停复盘 · 板块热度 · 市场情绪 · 连板梯队</p>
          </div>
        </div>
        <form id="dateForm" class="flex items-center gap-2 bg-white rounded-xl border border-gray-200 p-1.5 shadow-sm">
          <div class="flex items-center gap-1 pl-1">
            <i class="ri-calendar-2-line text-gray-400 text-base"></i>
            <input type="date" id="dateInput" name="date" value={date}
              class="bg-transparent text-sm font-medium text-gray-700 outline-none pr-2" />
          </div>
          <button type="submit" class="px-4 py-1.5 bg-[#ff4d4f] hover:bg-[#e23b3d] text-white text-sm font-semibold rounded-lg transition-colors shadow-sm flex items-center gap-1">
            <i class="ri-search-line"></i> 查询
          </button>
        </form>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 py-6 space-y-6">
      <!-- ============ 核心 KPI 面板 ============ -->
      <section class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-6 gap-4">
        <div class="bg-white rounded-2xl p-4 shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs text-gray-500 font-medium">今日涨停</span>
            <span class="w-8 h-8 rounded-lg bg-[#fff1f0] text-[#ff4d4f] flex items-center justify-center"><i class="ri-line-chart-line"></i></span>
          </div>
          <div class="text-3xl font-extrabold text-[#ff4d4f]">{totalCount}<span class="text-sm font-medium text-gray-400 ml-1">只</span></div>
          <p class="text-xs text-gray-400 mt-1">涨停家数</p>
        </div>
        <div class="bg-white rounded-2xl p-4 shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs text-gray-500 font-medium">平均涨幅</span>
            <span class="w-8 h-8 rounded-lg bg-[#f6ffed] text-[#52c41a] flex items-center justify-center"><i class="ri-arrow-up-double-fill"></i></span>
          </div>
          <div class="text-3xl font-extrabold text-[#52c41a]">{avgChange}<span class="text-sm font-medium text-gray-400 ml-1">%</span></div>
          <p class="text-xs text-gray-400 mt-1">平均涨幅</p>
        </div>
        <div class="bg-white rounded-2xl p-4 shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs text-gray-500 font-medium">最高连板</span>
            <span class="w-8 h-8 rounded-lg bg-[#fff7e6] text-[#fa8c16] flex items-center justify-center"><i class="ri-medal-fill"></i></span>
          </div>
          <div class="text-3xl font-extrabold text-[#fa8c16]">{maxLimitUp}<span class="text-sm font-medium text-gray-400 ml-1">板</span></div>
          <p class="text-xs text-gray-400 mt-1 truncate">龙头：{topStocksStr || '—'}</p>
        </div>
        <div class="bg-white rounded-2xl p-4 shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs text-gray-500 font-medium">连板股</span>
            <span class="w-8 h-8 rounded-lg bg-[#e6f7ff] text-[#1890ff] flex items-center justify-center"><i class="ri-stack-fill"></i></span>
          </div>
          <div class="text-3xl font-extrabold text-[#1890ff]">{lianbanCount}<span class="text-sm font-medium text-gray-400 ml-1">只</span></div>
          <p class="text-xs text-gray-400 mt-1">2板及以上（晋级率{lianbanRate}%）</p>
        </div>
        <div class="bg-white rounded-2xl p-4 shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs text-gray-500 font-medium">最热门板块</span>
            <span class="w-8 h-8 rounded-lg bg-[#f9f0ff] text-[#722ed1] flex items-center justify-center"><i class="ri-fire-fill"></i></span>
          </div>
          <div class="text-xl font-extrabold text-[#722ed1] leading-tight truncate" title={hotPlate}>{hotPlate}</div>
          <p class="text-xs text-gray-400 mt-1">{hotPlateCount} 只相关股票</p>
        </div>
        <div class="bg-white rounded-2xl p-4 shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs text-gray-500 font-medium">平均开板</span>
            <span class="w-8 h-8 rounded-lg bg-[#fff1e6] text-[#d46b08] flex items-center justify-center"><i class="ri-door-open-fill"></i></span>
          </div>
          <div class="text-3xl font-extrabold text-[#d46b08]">{avgBreak}<span class="text-sm font-medium text-gray-400 ml-1">次</span></div>
          <p class="text-xs text-gray-400 mt-1">平均炸板次数</p>
        </div>
      </section>

      <!-- ============ 市场情绪指标带 ============ -->
      <section class="grid grid-cols-2 lg:grid-cols-5 gap-4">
        <div class="bg-gradient-to-br from-[#fff1f0] to-white rounded-2xl p-4 border border-[#ffd6d5] flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-[#ff4d4f]/10 text-[#ff4d4f] flex items-center justify-center"><i class="ri-flag-2-line text-xl"></i></div>
          <div>
            <div class="text-2xl font-extrabold text-gray-800">{shoubanCount}<span class="text-sm text-gray-400 ml-1">家</span></div>
            <div class="text-xs text-gray-500">首板</div>
          </div>
        </div>
        <div class="bg-gradient-to-br from-[#e6f7ff] to-white rounded-2xl p-4 border border-[#bae7ff] flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-[#1890ff]/10 text-[#1890ff] flex items-center justify-center"><i class="ri-arrow-go-forward-line text-xl"></i></div>
          <div>
            <div class="text-2xl font-extrabold text-gray-800">{lianbanRate}<span class="text-sm text-gray-400 ml-1">%</span></div>
            <div class="text-xs text-gray-500">连板晋级率</div>
          </div>
        </div>
        <div class="bg-gradient-to-br from-[#f6ffed] to-white rounded-2xl p-4 border border-[#b7eb8f] flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-[#52c41a]/10 text-[#52c41a] flex items-center justify-center"><i class="ri-shield-check-line text-xl"></i></div>
          <div>
            <div class="text-2xl font-extrabold text-gray-800">{sealRate}<span class="text-sm text-gray-400 ml-1">%</span></div>
            <div class="text-xs text-gray-500">封板成功率（0开板）</div>
          </div>
        </div>
        <div class="bg-gradient-to-br from-[#fff7e6] to-white rounded-2xl p-4 border border-[#ffd591] flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-[#fa8c16]/10 text-[#fa8c16] flex items-center justify-center"><i class="ri-sun-fill text-xl"></i></div>
          <div>
            <div class="text-2xl font-extrabold text-gray-800">{earlyRate}<span class="text-sm text-gray-400 ml-1">%</span></div>
            <div class="text-xs text-gray-500">早盘(10点前)封板</div>
          </div>
        </div>
        <div class="bg-gradient-to-br from-[#f9f0ff] to-white rounded-2xl p-4 border border-[#d3adf7] flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-[#722ed1]/10 text-[#722ed1] flex items-center justify-center"><i class="ri-stack-fill text-xl"></i></div>
          <div>
            <div class="text-2xl font-extrabold text-gray-800">{avgDays}<span class="text-sm text-gray-400 ml-1">板</span></div>
            <div class="text-xs text-gray-500">平均连板高度</div>
          </div>
        </div>
      </section>

      <!-- ============ 连板晋级结构（梯队） ============ -->
      <section class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="px-5 pt-4 flex items-center gap-2">
          <i class="ri-bar-chart-box-fill text-[#1890ff] text-lg"></i>
          <h2 class="font-semibold text-gray-800">连板晋级结构</h2>
          <span class="text-xs text-gray-400">相邻高度间的晋级率，反映市场高度拓展与接力意愿</span>
        </div>
        <div class="p-5 grid grid-cols-5 gap-3 md:gap-4">
          {[['首板', c1, null], ['2板', c2, r12], ['3板', c3, r23], ['4板', c4, r34], ['5板+', c5, r45]].map((tier, idx) => {
            const [label, count, rate] = tier;
            const baseMax = Math.max(c1, 1);
            const w = Math.max(6, Math.round(count / baseMax * 100));
            const color = ['bg-[#52c41a]', 'bg-[#fa8c16]', 'bg-[#1890ff]', 'bg-[#722ed1]', 'bg-[#ff4d4f]'][idx];
            return (
              <div class="text-center">
                <div class="text-3xl font-extrabold text-gray-800 leading-none">{count}</div>
                <div class="text-xs text-gray-500 mt-1 mb-3">{label}</div>
                <div class="h-40 bg-gray-50 rounded-lg flex items-end justify-center pb-1 overflow-hidden">
                  <div class={`w-7 ${color} rounded-t-md transition-all`} style={`height:${w}%`}></div>
                </div>
                {rate != null && (
                  <div class="mt-3 inline-flex items-center gap-1 text-xs px-2 py-1 rounded-full bg-gray-100 text-gray-600">
                    <i class="ri-arrow-right-line text-[11px]"></i> 晋级率 {rate}%
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </section>

      <!-- ============ 数据洞察（自动生成） ============ -->
      <section class="bg-gradient-to-br from-[#eef3ff] to-white rounded-2xl shadow-sm border border-[#d6e4ff] p-5">
        <div class="flex items-center gap-2 mb-3">
          <i class="ri-lightbulb-flash-line text-[#2f54eb] text-lg"></i>
          <h2 class="font-semibold text-gray-800">今日数据洞察</h2>
          <span class="text-xs text-gray-400 ml-auto flex items-center gap-1"><i class="ri-sparkling-2-line"></i>根据数据自动生成</span>
        </div>
        <ul class="space-y-2 text-sm text-gray-700">
          {insights.map((t, i) => (
            <li class="flex items-start gap-2">
              <span class="w-5 h-5 rounded-full bg-[#2f54eb] text-white text-[11px] flex items-center justify-center font-semibold shrink-0">{i + 1}</span>
              <span set:html={t}></span>
            </li>
          ))}
        </ul>
      </section>

      <!-- ============ 图表分析 ============ -->
      <section>
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-bold text-gray-900 flex items-center gap-2">
            <i class="ri-donut-chart-fill text-[#ff4d4f] text-xl"></i>
            市场热点分析
          </h2>
          <span class="text-xs text-gray-400">{date} 数据</span>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
          <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="px-5 pt-4">
              <h3 class="font-semibold text-gray-800 flex items-center gap-1.5"><i class="ri-bubble-chart-fill text-[#722ed1]"></i>板块涨停碰撞图</h3>
              <p class="text-xs text-gray-400">Top 15 板块 · 气泡面积代表涨停家数</p>
            </div>
            <div class="relative p-4 h-80">
              <div id="plateBubbleChart" class="relative w-full h-full" aria-label="板块涨停数量气泡图"></div>
            </div>
          </div>
          <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="px-5 pt-4">
              <h3 class="font-semibold text-gray-800 flex items-center gap-1.5"><i class="ri-bar-chart-grouped-line text-[#1890ff]"></i>板块涨停数量排行</h3>
              <p class="text-xs text-gray-400">Top 15 板块涨停家数</p>
            </div>
            <div class="p-4 h-80"><canvas id="changePercentChart"></canvas></div>
          </div>
          <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="px-5 pt-4">
              <h3 class="font-semibold text-gray-800 flex items-center gap-1.5"><i class="ri-time-line text-[#fa8c16]"></i>首次涨停时间分布</h3>
              <p class="text-xs text-gray-400">各时间段封板家数</p>
            </div>
            <div class="p-4 h-72"><canvas id="firstLimitUpTimeChart"></canvas></div>
          </div>
          <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="px-5 pt-4">
              <h3 class="font-semibold text-gray-800 flex items-center gap-1.5"><i class="ri-stack-fill text-[#52c41a]"></i>连板高度分布</h3>
              <p class="text-xs text-gray-400">首板 / 连板梯队家数</p>
            </div>
            <div class="p-4 h-72"><canvas id="limitUpLadderChart"></canvas></div>
          </div>
          <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="px-5 pt-4">
              <h3 class="font-semibold text-gray-800 flex items-center gap-1.5"><i class="ri-focus-3-fill text-[#eb2f96]"></i>涨停原因排行</h3>
              <p class="text-xs text-gray-400">Top 10 涨停驱动题材</p>
            </div>
            <div class="p-4 h-72"><canvas id="surgeReasonChart"></canvas></div>
          </div>
          <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="px-5 pt-4">
              <h3 class="font-semibold text-gray-800 flex items-center gap-1.5"><i class="ri-door-open-fill text-[#d46b08]"></i>封板强度（开板次数）分布</h3>
              <p class="text-xs text-gray-400">封板越强开板次数越少</p>
            </div>
            <div class="p-4 h-72"><canvas id="breakTimesChart"></canvas></div>
          </div>
        </div>
      </section>

      <!-- ============ 板块深度分析 ============ -->
      <section class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="px-5 pt-4 pb-2 flex items-center gap-2">
          <i class="ri-bar-chart-box-fill text-[#722ed1] text-lg"></i>
          <h2 class="font-semibold text-gray-800">板块深度分析</h2>
          <span class="text-xs text-gray-400">Top 12 板块 · 龙头/高度/强度</span>
        </div>
        <div class="overflow-x-auto px-2 pb-3">
          <table class="table table-sm w-full">
            <thead class="text-gray-500">
              <tr class="border-b border-gray-100 text-xs uppercase tracking-wide">
                <th class="px-4 py-2.5 font-semibold">板块</th>
                <th class="px-4 py-2.5 font-semibold text-center">涨停家数</th>
                <th class="px-4 py-2.5 font-semibold text-center">最高连板</th>
                <th class="px-4 py-2.5 font-semibold text-center">平均连板</th>
                <th class="px-4 py-2.5 font-semibold text-center">平均涨幅</th>
                <th class="px-4 py-2.5 font-semibold">龙头股</th>
                <th class="px-4 py-2.5 font-semibold w-40">深度占比</th>
              </tr>
            </thead>
            <tbody>
              {plateDetail.map(p => {
                const maxCount = Math.max(...plateDetail.map(x => x.count), 1);
                const depthW = Math.round(p.count / maxCount * 100);
                return (
                  <tr class="border-b border-gray-50 hover:bg-[#fafbff] transition-colors">
                    <td class="px-4 py-2.5">
                      {p.plate === hotPlate
                        ? <span class="inline-flex items-center gap-1 font-semibold text-[#ff4d4f]"><i class="ri-fire-fill text-xs"></i>{p.plate}</span>
                        : <span class="font-medium text-gray-700">{p.plate}</span>}
                    </td>
                    <td class="px-4 py-2.5 text-center font-semibold text-gray-800">{p.count}</td>
                    <td class="px-4 py-2.5 text-center">
                      <span class="inline-flex px-2 py-0.5 rounded-md text-xs font-bold {p.maxD >= 3 ? 'bg-[#fff1f0] text-[#ff4d4f]' : p.maxD >= 2 ? 'bg-[#fff7e6] text-[#fa8c16]' : 'bg-gray-100 text-gray-500'}">{p.maxD}板</span>
                    </td>
                    <td class="px-4 py-2.5 text-center text-xs text-gray-600">{p.avgDays}</td>
                    <td class="px-4 py-2.5 text-center text-xs font-medium {Number(p.avgChange) > 0 ? 'text-[#ff4d4f]' : 'text-[#52c41a]'}">{p.avgChange}%</td>
                    <td class="px-4 py-2.5 text-xs text-gray-700 max-w-[160px] truncate" title={p.leader}>{p.leader}</td>
                    <td class="px-4 py-2.5">
                      <div class="flex items-center gap-2">
                        <div class="flex-1 h-2 bg-gray-100 rounded-full overflow-hidden">
                          <div class="h-full rounded-full {p.plate === hotPlate ? 'bg-[#ff4d4f]' : 'bg-gradient-to-r from-[#1890ff] to-[#69c0ff]'}" style={`width:${depthW}%`}></div>
                        </div>
                        <span class="text-[11px] text-gray-400 w-8 text-right">{depthW}%</span>
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>

      <!-- ============ 板块分类筛选 ============ -->
      <section class="bg-white rounded-2xl shadow-sm border border-gray-100 p-4">
        <div class="flex items-center gap-2 mb-3">
          <i class="ri-filter-3-line text-gray-400"></i>
          <span class="text-sm font-semibold text-gray-800">按板块筛选</span>
          <span class="text-xs text-gray-400">共 {platesList.length} 个板块</span>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href={`/dashboard?date=${date}`}
            class={`px-3 py-1.5 rounded-full text-xs font-medium transition-colors ${!selectedPlate ? 'bg-[#ff4d4f] text-white shadow-sm' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}`}>
            全部 <span class="opacity-80">({totalCount})</span>
          </a>
          {platesList.map(plate => (
            <a href={`/dashboard?date=${date}&plate=${encodeURIComponent(plate)}`
              }
              class={`px-3 py-1.5 rounded-full text-xs font-medium transition-colors ${selectedPlate === plate ? 'bg-[#ff4d4f] text-white shadow-sm' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}`}>
              {plate} <span class="opacity-80">({allPlatesCounter.get(plate)})</span>
            </a>
          ))}
        </div>
      </section>

      <!-- ============ 涨停明细表格 ============ -->
      <section class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="px-5 pt-4 pb-3 flex flex-col md:flex-row md:items-center md:justify-between gap-3">
          <div>
            <h2 class="text-lg font-bold text-gray-900 flex items-center gap-2">
              <i class="ri-table-fill text-[#1890ff] text-xl"></i>
              涨停明细
            </h2>
            <p class="text-xs text-gray-400">
              <span id="resultCount" class="font-semibold text-gray-600">0</span> 条记录
              {selectedPlate && <span class="ml-1">· 筛选板块：{selectedPlate}</span>}
            </p>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <div class="relative">
              <i class="ri-search-line text-gray-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
              <input type="text" id="searchInput" placeholder="搜索名称/代码/题材/板块..."
                class="pl-9 pr-3 py-2 text-sm bg-gray-50 border border-gray-200 rounded-lg outline-none focus:border-[#1890ff] focus:ring-2 focus:ring-[#1890ff]/20 transition w-52 md:w-60" />
            </div>
            <div class="relative" id="colToggleWrap">
              <button id="colToggleBtn" class="px-3 py-2 text-sm font-medium bg-gray-50 border border-gray-200 rounded-lg hover:bg-gray-100 transition flex items-center gap-1.5">
                <i class="ri-settings-4-line"></i> 列
              </button>
              <div id="colMenu" class="hidden absolute right-0 mt-2 w-48 bg-white border border-gray-200 rounded-xl shadow-lg p-2 z-20">
                <p class="text-xs text-gray-400 px-2 py-1">显示 / 隐藏列</p>
              </div>
            </div>
            <button id="exportBtn" class="px-3 py-2 text-sm font-medium bg-[#1890ff] hover:bg-[#0f7fd4] text-white rounded-lg transition flex items-center gap-1.5 shadow-sm">
              <i class="ri-download-2-line"></i> 导出CSV
            </button>
          </div>
        </div>
        <div class="overflow-x-auto">
          <table class="table table-sm w-full">
            <thead class="bg-gray-50 text-gray-500">
              <tr class="border-b border-gray-200 text-xs uppercase tracking-wide">
                <th class="px-4 py-3 font-semibold" data-col="seq">#</th>
                <th class="px-4 py-3 font-semibold cursor-pointer hover:text-[#1890ff] select-none" data-col="code" data-sort="stock_code">代码 <span class="sort-arrow" data-arrow="stock_code"></span></th>
                <th class="px-4 py-3 font-semibold cursor-pointer hover:text-[#1890ff] select-none" data-col="name" data-sort="stock_name">名称 <span class="sort-arrow" data-arrow="stock_name"></span></th>
                <th class="px-4 py-3 font-semibold cursor-pointer hover:text-[#1890ff] select-none" data-col="days" data-sort="limit_up_days">连板 <span class="sort-arrow" data-arrow="limit_up_days"></span></th>
                <th class="px-4 py-3 font-semibold" data-col="reason">涨停原因</th>
                <th class="px-4 py-3 font-semibold cursor-pointer hover:text-[#1890ff] select-none" data-col="price" data-sort="price">价格 <span class="sort-arrow" data-arrow="price"></span></th>
                <th class="px-4 py-3 font-semibold cursor-pointer hover:text-[#1890ff] select-none" data-col="change" data-sort="change_percent">涨幅 <span class="sort-arrow" data-arrow="change_percent"></span></th>
                <th class="px-4 py-3 font-semibold cursor-pointer hover:text-[#1890ff] select-none" data-col="first" data-sort="first_limit_up">首次涨停 <span class="sort-arrow" data-arrow="first_limit_up"></span></th>
                <th class="px-4 py-3 font-semibold cursor-pointer hover:text-[#1890ff] select-none" data-col="last" data-sort="last_limit_up">最后涨停 <span class="sort-arrow" data-arrow="last_limit_up"></span></th>
                <th class="px-4 py-3 font-semibold cursor-pointer hover:text-[#1890ff] select-none" data-col="break" data-sort="break_limit_up_times">开板 <span class="sort-arrow" data-arrow="break_limit_up_times"></span></th>
                <th class="px-4 py-3 font-semibold" data-col="plates">板块</th>
              </tr>
            </thead>
            <tbody id="tableBody">
              <tr><td colspan="11" class="text-center py-8 text-gray-400 text-sm"><i class="ri-loader-4-line animate-spin inline-block mr-1"></i>加载中...</td></tr>
            </tbody>
          </table>
        </div>
        <div class="px-5 py-3 border-t border-gray-100 flex flex-col sm:flex-row items-center justify-between gap-3">
          <div class="flex items-center gap-2 text-sm text-gray-500">
            每页
            <select id="pageSize" class="bg-gray-50 border border-gray-200 rounded-lg px-2 py-1 text-sm outline-none">
              <option value="10">10</option><option value="20" selected>20</option><option value="50">50</option><option value="100">100</option>
            </select> 条
          </div>
          <div class="flex items-center gap-1" id="pagination">
            <button id="pagePrev" class="px-3 py-1.5 text-sm bg-gray-50 border border-gray-200 rounded-lg hover:bg-gray-100 disabled:opacity-40 disabled:cursor-not-allowed transition flex items-center gap-1"><i class="ri-arrow-left-line"></i>上一页</button>
            <span id="pageInfo" class="px-3 text-sm text-gray-600">1 / 1</span>
            <button id="pageNext" class="px-3 py-1.5 text-sm bg-gray-50 border border-gray-200 rounded-lg hover:bg-gray-100 disabled:opacity-40 disabled:cursor-not-allowed transition flex items-center gap-1">下一页<i class="ri-arrow-right-line"></i></button>
          </div>
        </div>
      </section>
    </main>
  </div>

  <!-- 将服务端数据传递给客户端 -->
  <script define:vars={{ stocks }}>
    window.stocksData = stocks;
  </script>

  <script>
    import Chart from 'chart.js/auto';
    import ChartDataLabels from 'chartjs-plugin-datalabels';
    import { forceCollide, forceSimulation, forceX, forceY } from 'd3-force';
    Chart.register(ChartDataLabels);

    const stocks = window.stocksData || [];

    // 解析连板板数（"首板"→1，"2连板"→2 ...）
    const toDays = (v) => { const m = String(v ?? '').match(/\d+/); return m ? parseInt(m[0], 10) : 1; };

    const CHART_COLORS = ['#ff4d4f', '#1890ff', '#fa8c16', '#52c41a', '#722ed1', '#13c2c2', '#eb2f96', '#fadb14', '#2f54eb', '#a0d911'];
    const alpha = (hex, a) => {
      const r = parseInt(hex.slice(1, 3), 16), g = parseInt(hex.slice(3, 5), 16), b = parseInt(hex.slice(5, 7), 16);
      return `rgba(${r},${g},${b},${a})`;
    };
    const gridColor = 'rgba(0,0,0,0.05)', tickColor = '#9ca3af';
    const baseChartOpts = (extra = {}) => ({
      responsive: true, maintainAspectRatio: false,
      plugins: {
        legend: { labels: { color: tickColor, usePointStyle: true, pointStyle: 'circle', boxWidth: 8, padding: 15, font: { size: 11 } } },
        tooltip: { backgroundColor: 'rgba(25,25,35,0.9)', padding: 10, cornerRadius: 8, titleFont: { size: 12 }, bodyFont: { size: 12 } },
      },
      scales: {
        x: { grid: { color: gridColor }, ticks: { color: tickColor, font: { size: 10 } } },
        y: { grid: { color: gridColor }, ticks: { color: tickColor, font: { size: 10 }, beginAtZero: true } },
      },
      ...extra,
    });

    document.getElementById('dateForm').addEventListener('submit', function (e) {
      e.preventDefault();
      const date = document.getElementById('dateInput').value;
      const u = new URL(window.location.href);
      const plate = u.searchParams.get('plate') || '';
      window.location.href = plate ? `/dashboard?date=${date}&plate=${encodeURIComponent(plate)}` : `/dashboard?date=${date}`;
    });

    function countBy(fn) {
      const map = new Map();
      stocks.forEach(s => { const k = fn(s); if (k !== undefined && k !== null && k !== '') map.set(k, (map.get(k) || 0) + 1); });
      return map;
    }
    function countPlates() {
      const map = new Map();
      stocks.forEach(s => {
        if (!s.plates) return;
        s.plates.split(',').forEach(p => { const t = p.trim(); map.set(t, (map.get(t) || 0) + 1); });
      });
      return map;
    }
    function registerChart(id, fn) { const ctx = document.getElementById(id); if (ctx) fn(ctx); }

    function initPlateBubbleChart() {
      const container = document.getElementById('plateBubbleChart');
      if (!container) return;

      const sorted = Array.from(countPlates().entries())
        .sort((a, b) => b[1] - a[1])
        .slice(0, 15);

      if (sorted.length === 0) {
        container.innerHTML = '<div class="h-full flex items-center justify-center text-sm text-gray-400">当日暂无板块涨停数据</div>';
        return;
      }

      let simulation;
      let resizeTimer;
      let warmupTimer;
      const svgNs = 'http://www.w3.org/2000/svg';
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function render() {
        if (simulation) simulation.stop();
        clearTimeout(warmupTimer);
        container.innerHTML = '';

        const width = Math.max(container.clientWidth, 280);
        const height = Math.max(container.clientHeight, 240);
        const maxCount = sorted[0][1];
        const totalWeight = sorted.reduce((sum, [, count]) => sum + count / maxCount, 0);
        const areaRadius = Math.sqrt((width * height * 0.48) / (Math.PI * totalWeight));
        const maxRadius = Math.min(64, width / 5, height / 3.3, areaRadius);
        const centerX = width / 2;
        const centerY = height / 2;

        const nodes = sorted.map(([plate, count], index) => {
          const angle = (Math.PI * 2 * index) / sorted.length;
          return {
            plate,
            count,
            radius: maxRadius * Math.sqrt(count / maxCount),
            x: centerX + Math.cos(angle) * 5,
            y: centerY + Math.sin(angle) * 5,
          };
        });

        const svg = document.createElementNS(svgNs, 'svg');
        svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
        svg.setAttribute('class', 'block w-full h-full overflow-visible');
        svg.setAttribute('role', 'img');
        svg.setAttribute('aria-label', `涨停板块气泡图，共 ${nodes.length} 个板块`);
        container.appendChild(svg);

        const tooltip = document.createElement('div');
        tooltip.className = 'pointer-events-none absolute hidden z-10 rounded-lg bg-gray-900/90 px-3 py-2 text-xs text-white shadow-lg';
        container.appendChild(tooltip);

        const groups = nodes.map((node, index) => {
          const group = document.createElementNS(svgNs, 'g');
          group.setAttribute('tabindex', '0');
          group.setAttribute('role', 'link');
          group.setAttribute('aria-label', `${node.plate}，${node.count} 只涨停股票，点击筛选`);
          group.setAttribute('class', 'cursor-pointer outline-none');

          const circle = document.createElementNS(svgNs, 'circle');
          circle.setAttribute('r', String(node.radius));
          circle.setAttribute('fill', alpha(CHART_COLORS[index % CHART_COLORS.length], 0.88));
          circle.setAttribute('stroke', '#ffffff');
          circle.setAttribute('stroke-width', '2');
          circle.style.transition = 'filter 160ms ease, opacity 160ms ease';
          group.appendChild(circle);

          const fontSize = Math.max(10, Math.min(13, node.radius / 3.4));
          const maxChars = Math.max(2, Math.floor((node.radius * 1.55) / fontSize));
          const label = node.plate.length > maxChars ? `${node.plate.slice(0, Math.max(1, maxChars - 1))}…` : node.plate;

          const nameText = document.createElementNS(svgNs, 'text');
          nameText.setAttribute('text-anchor', 'middle');
          nameText.setAttribute('y', node.radius >= 34 ? '-3' : '4');
          nameText.setAttribute('fill', '#ffffff');
          nameText.setAttribute('font-size', String(fontSize));
          nameText.setAttribute('font-weight', '700');
          nameText.setAttribute('pointer-events', 'none');
          nameText.textContent = label;
          group.appendChild(nameText);

          if (node.radius >= 34) {
            const countText = document.createElementNS(svgNs, 'text');
            countText.setAttribute('text-anchor', 'middle');
            countText.setAttribute('y', String(fontSize + 5));
            countText.setAttribute('fill', 'rgba(255,255,255,0.86)');
            countText.setAttribute('font-size', String(Math.max(10, fontSize - 1)));
            countText.setAttribute('pointer-events', 'none');
            countText.textContent = `${node.count}只`;
            group.appendChild(countText);
          }

          const showTooltip = () => {
            circle.setAttribute('stroke-width', '4');
            circle.style.filter = 'brightness(1.08)';
            tooltip.textContent = `${node.plate} · ${node.count} 只涨停股票`;
            tooltip.classList.remove('hidden');
            tooltip.style.left = `${Math.min(node.x + node.radius + 8, width - tooltip.offsetWidth - 4)}px`;
            tooltip.style.top = `${Math.max(node.y - tooltip.offsetHeight / 2, 4)}px`;
          };
          const hideTooltip = () => {
            circle.setAttribute('stroke-width', '2');
            circle.style.filter = '';
            tooltip.classList.add('hidden');
          };
          const moveTooltip = (event) => {
            const rect = container.getBoundingClientRect();
            const tooltipX = Math.min(event.clientX - rect.left + 12, width - tooltip.offsetWidth - 4);
            const tooltipY = Math.max(event.clientY - rect.top - tooltip.offsetHeight - 10, 4);
            tooltip.style.left = `${tooltipX}px`;
            tooltip.style.top = `${tooltipY}px`;
          };
          const goToPlate = () => {
            const dateValue = document.getElementById('dateInput').value;
            window.location.href = `/dashboard?date=${dateValue}&plate=${encodeURIComponent(node.plate)}`;
          };

          group.addEventListener('mouseenter', showTooltip);
          group.addEventListener('mousemove', moveTooltip);
          group.addEventListener('mouseleave', hideTooltip);
          group.addEventListener('focus', showTooltip);
          group.addEventListener('blur', hideTooltip);
          group.addEventListener('click', goToPlate);
          group.addEventListener('keydown', (event) => {
            if (event.key === 'Enter' || event.key === ' ') {
              event.preventDefault();
              goToPlate();
            }
          });

          svg.appendChild(group);
          return group;
        });

        simulation = forceSimulation(nodes)
          .force('x', forceX(centerX).strength(0.075))
          .force('y', forceY(centerY).strength(0.075))
          .force('collide', forceCollide(node => node.radius + 3).iterations(3))
          .alpha(0.08)
          .alphaTarget(0.6)
          .alphaDecay(0.06)
          .velocityDecay(0.4)
          .on('tick', () => {
            nodes.forEach((node, index) => {
              node.x = Math.max(node.radius, Math.min(width - node.radius, node.x));
              node.y = Math.max(node.radius, Math.min(height - node.radius, node.y));
              groups[index].setAttribute('transform', `translate(${node.x},${node.y})`);
            });
          });

        if (reducedMotion) {
          simulation
            .alpha(1)
            .alphaTarget(0)
            .alphaDecay(1 - Math.pow(0.001, 1 / 180))
            .stop();
          simulation.tick(180);
          nodes.forEach((node, index) => {
            groups[index].setAttribute('transform', `translate(${node.x},${node.y})`);
          });
        } else {
          warmupTimer = setTimeout(() => {
            simulation
              .alphaTarget(0)
              .alphaDecay(1 - Math.pow(0.001, 1 / 180));
          }, 2000);
        }
      }

      render();
      const observer = new ResizeObserver(() => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(render, 120);
      });
      observer.observe(container);
    }

    document.addEventListener('DOMContentLoaded', function () {
      // 1. 板块涨停碰撞图
      initPlateBubbleChart();

      // 2. 板块涨停数量排行
      registerChart('changePercentChart', (ctx) => {
        const sorted = Array.from(countPlates().entries()).sort((a, b) => b[1] - a[1]).slice(0, 15);
        new Chart(ctx, {
          type: 'bar',
          data: { labels: sorted.map(i => i[0]), datasets: [{ label: '涨停家数', data: sorted.map(i => i[1]), backgroundColor: CHART_COLORS.map(c => alpha(c, 0.75)), borderColor: CHART_COLORS, borderWidth: 1, borderRadius: 4 }] },
          options: baseChartOpts({ indexAxis: 'y', plugins: { legend: { display: false }, datalabels: { color: '#333', anchor: 'end', align: 'end', font: { size: 10 } } } }),
        });
      });

      // 3. 首次涨停时间分布
      registerChart('firstLimitUpTimeChart', (ctx) => {
        const timeSlots = ['09:30', '09:45', '10:00', '10:15', '10:30', '10:45', '11:00', '11:15', '11:30', '13:00', '13:15', '13:30', '13:45', '14:00', '14:15', '14:30', '14:45', '15:00'];
        const dist = new Map(timeSlots.map(t => [t, 0]));
        stocks.forEach(s => { if (!s.first_limit_up) return; for (const slot of timeSlots) { if (s.first_limit_up <= slot) { dist.set(slot, dist.get(slot) + 1); break; } } });
        const labels = Array.from(dist.keys()).filter(t => dist.get(t) > 0 || t <= '10:00');
        const idxs = labels.map(l => timeSlots.indexOf(l));
        new Chart(ctx, {
          type: 'bar',
          data: { labels, datasets: [{ label: '首次涨停数量', data: labels.map(l => dist.get(l)), backgroundColor: idxs.map(i => (i <= 3 ? alpha('#52c41a', 0.8) : i <= 9 ? alpha('#fa8c16', 0.8) : alpha('#ff4d4f', 0.8))), borderColor: '#fff', borderWidth: 1, borderRadius: 4 }] },
          options: baseChartOpts({ plugins: { legend: { display: false }, datalabels: { color: '#333', anchor: 'end', align: 'end', font: { size: 10 } } } }),
        });
      });

      // 4. 连板高度分布
      registerChart('limitUpLadderChart', (ctx) => {
        const labelMap = new Map();
        stocks.forEach(s => { const d = toDays(s.limit_up_days); const key = d >= 5 ? '5板+ 高位' : `${d}板`; labelMap.set(key, (labelMap.get(key) || 0) + 1); });
        const order = ['1板', '2板', '3板', '4板', '5板+ 高位'];
        const labels = order.filter(l => labelMap.has(l));
        new Chart(ctx, {
          type: 'bar',
          data: { labels, datasets: [{ label: '家数', data: labels.map(l => labelMap.get(l)), backgroundColor: labels.map((l, i) => alpha(i === labels.length - 1 ? '#ff4d4f' : '#1890ff', 0.75)), borderColor: labels.map((l, i) => (i === labels.length - 1 ? '#ff4d4f' : '#1890ff')), borderWidth: 1, borderRadius: 6 }] },
          options: baseChartOpts({ plugins: { legend: { display: false }, datalabels: { color: '#333', anchor: 'end', align: 'end', font: { size: 12, weight: 'bold' } } } }),
        });
      });

      // 5. 涨停原因排行
      registerChart('surgeReasonChart', (ctx) => {
        const sorted = Array.from(countBy(s => s.surge_reason && s.surge_reason.trim()).entries()).sort((a, b) => b[1] - a[1]).slice(0, 10);
        new Chart(ctx, {
          type: 'bar',
          data: { labels: sorted.map(i => (i[0].length > 12 ? i[0].slice(0, 12) + '…' : i[0])), datasets: [{ label: '家数', data: sorted.map(i => i[1]), backgroundColor: CHART_COLORS.map(c => alpha(c, 0.75)), borderColor: CHART_COLORS, borderWidth: 1, borderRadius: 4 }] },
          options: baseChartOpts({ indexAxis: 'y', plugins: { legend: { display: false }, datalabels: { color: '#333', anchor: 'end', align: 'end', font: { size: 10 } } } }),
        });
      });

      // 6. 开板次数分布
      registerChart('breakTimesChart', (ctx) => {
        const sorted = Array.from(countBy(s => (s.break_limit_up_times == null || s.break_limit_up_times === '') ? null : `${Number(s.break_limit_up_times)}次`).entries()).sort((a, b) => parseInt(a[0]) - parseInt(b[0])).slice(0, 8);
        new Chart(ctx, {
          type: 'bar',
          data: { labels: sorted.map(i => i[0]), datasets: [{ label: '家数', data: sorted.map(i => i[1]), backgroundColor: sorted.map((_, i) => alpha(i === 0 ? '#52c41a' : i <= 2 ? '#fa8c16' : '#ff4d4f', 0.75)), borderColor: sorted.map((_, i) => (i === 0 ? '#52c41a' : i <= 2 ? '#fa8c16' : '#ff4d4f')), borderWidth: 1, borderRadius: 4 }] },
          options: baseChartOpts({ plugins: { legend: { display: false }, datalabels: { color: '#333', anchor: 'end', align: 'end', font: { size: 11 } } } }),
        });
      });

      initTable();
    });

    // ===================== 数据表格 =====================
    function initTable() {
      const tableBody = document.getElementById('tableBody');
      const searchInput = document.getElementById('searchInput');
      const pageSizeSel = document.getElementById('pageSize');
      const pagePrev = document.getElementById('pagePrev');
      const pageNext = document.getElementById('pageNext');
      const pageInfo = document.getElementById('pageInfo');
      const resultCount = document.getElementById('resultCount');
      let state = { query: '', sortKey: '', sortDir: 1, page: 1, pageSize: 20, hiddenCols: new Set() };

      const columns = [
        { key: 'code', label: '代码' }, { key: 'name', label: '名称' }, { key: 'days', label: '连板' },
        { key: 'reason', label: '涨停原因' }, { key: 'price', label: '价格' }, { key: 'change', label: '涨幅' },
        { key: 'first', label: '首次涨停' }, { key: 'last', label: '最后涨停' }, { key: 'break', label: '开板' }, { key: 'plates', label: '板块' },
      ];

      function filteredStocks() {
        const q = state.query.trim().toLowerCase();
        if (!q) return stocks;
        return stocks.filter(s => [s.stock_code, s.stock_name, s.surge_reason, (s.plates || '')].some(v => (v || '').toLowerCase().includes(q)));
      }
      function getValue(s, key) {
        if (key === 'limit_up_days') return toDays(s[key]);
        if (['change_percent', 'price', 'break_limit_up_times'].includes(key)) return Number(s[key]) || 0;
        return (s[key] || '');
      }
      function hidden(key) { return state.hiddenCols.has(key); }
      function applyColumnVisibility() {
        document.querySelectorAll('th[data-col]').forEach(th => { th.style.display = state.hiddenCols.has(th.dataset.col) ? 'none' : ''; });
      }
      function render() {
        let rows = filteredStocks();
        if (state.sortKey) {
          rows = [...rows].sort((a, b) => {
            const va = getValue(a, state.sortKey), vb = getValue(b, state.sortKey);
            if (typeof va === 'string' && typeof vb === 'string') return va.localeCompare(vb, 'zh') * state.sortDir;
            return (va > vb ? 1 : va < vb ? -1 : 0) * state.sortDir;
          });
        }
        const total = rows.length;
        const totalPages = Math.max(1, Math.ceil(total / state.pageSize));
        if (state.page > totalPages) state.page = totalPages;
        const start = (state.page - 1) * state.pageSize;
        const pageRows = rows.slice(start, start + state.pageSize);
        resultCount.textContent = total;

        if (pageRows.length === 0) {
          tableBody.innerHTML = `<tr><td colspan="11" class="text-center py-10 text-gray-400 text-sm">暂无数据</td></tr>`;
        } else {
          tableBody.innerHTML = pageRows.map((s, i) => {
            const seq = start + i + 1;
            const days = toDays(s.limit_up_days);
            const change = Number(s.change_percent) || 0;
            const breaks = Number(s.break_limit_up_times) || 0;
            const dayBadge = days >= 3 ? `<span class="inline-flex items-center px-2 py-0.5 rounded-md bg-[#fff1f0] text-[#ff4d4f] font-bold text-xs">${days}板</span>`
              : days >= 2 ? `<span class="inline-flex items-center px-2 py-0.5 rounded-md bg-[#fff7e6] text-[#fa8c16] font-bold text-xs">${days}板</span>`
              : `<span class="inline-flex items-center px-2 py-0.5 rounded-md bg-gray-100 text-gray-500 text-xs">首板</span>`;
            const changeCls = change > 0 ? 'text-[#ff4d4f]' : 'text-[#52c41a]';
            const breakCls = breaks === 0 ? 'text-gray-600' : breaks <= 2 ? 'text-[#fa8c16]' : 'text-[#ff4d4f]';
            const platesHtml = (s.plates || '').split(',').filter(p => p.trim()).map(p => `<span class="inline-block px-2 py-0.5 rounded-full bg-gray-100 text-gray-600 text-[11px] mr-1 mb-0.5">${p.trim()}</span>`).join('');

            const cells = [];
            cells.push(`<td data-col="seq" class="px-4 py-2.5 text-gray-400 text-xs">${seq}</td>`);
            cells.push(hidden('code') ? '' : `<td data-col="code" class="px-4 py-2.5 font-mono text-xs text-gray-600">${s.stock_code}</td>`);
            cells.push(hidden('name') ? '' : `<td data-col="name" class="px-4 py-2.5 font-semibold text-gray-800">${s.stock_name}</td>`);
            cells.push(hidden('days') ? '' : `<td data-col="days" class="px-4 py-2.5">${dayBadge}</td>`);
            cells.push(hidden('reason') ? '' : `<td data-col="reason" class="px-4 py-2.5 text-xs text-gray-600 max-w-[200px] truncate" title="${s.surge_reason || ''}">${s.surge_reason || '—'}</td>`);
            cells.push(hidden('price') ? '' : `<td data-col="price" class="px-4 py-2.5 text-xs text-gray-700">${Number(s.price) ? Number(s.price).toFixed(2) : '—'}</td>`);
            cells.push(hidden('change') ? '' : `<td data-col="change" class="px-4 py-2.5 text-xs font-semibold ${changeCls}">${change.toFixed(2)}%</td>`);
            cells.push(hidden('first') ? '' : `<td data-col="first" class="px-4 py-2.5 text-xs text-gray-600">${s.first_limit_up || '—'}</td>`);
            cells.push(hidden('last') ? '' : `<td data-col="last" class="px-4 py-2.5 text-xs text-gray-600">${s.last_limit_up || '—'}</td>`);
            cells.push(hidden('break') ? '' : `<td data-col="break" class="px-4 py-2.5 text-xs font-medium ${breakCls}">${s.break_limit_up_times == null || s.break_limit_up_times === '' ? '—' : breaks}</td>`);
            cells.push(hidden('plates') ? '' : `<td data-col="plates" class="px-4 py-2.5">${platesHtml}</td>`);
            return `<tr class="border-b border-gray-50 hover:bg-[#fafbff] transition-colors">${cells.join('')}</tr>`;
          }).join('');
        }

        pageInfo.textContent = `${state.page} / ${totalPages}`;
        pagePrev.disabled = state.page <= 1;
        pageNext.disabled = state.page >= totalPages;
        document.querySelectorAll('[data-arrow]').forEach(el => { el.textContent = ''; });
        if (state.sortKey) {
          const arrow = document.querySelector(`[data-arrow="${state.sortKey}"]`);
          if (arrow) arrow.textContent = state.sortDir === 1 ? ' ▲' : ' ▼';
        }
        applyColumnVisibility();
      }

      searchInput.addEventListener('input', () => { state.query = searchInput.value; state.page = 1; render(); });
      pageSizeSel.addEventListener('change', () => { state.pageSize = parseInt(pageSizeSel.value); state.page = 1; render(); });
      pagePrev.addEventListener('click', () => { if (state.page > 1) { state.page--; render(); } });
      pageNext.addEventListener('click', () => { state.page++; render(); });
      document.querySelectorAll('th[data-sort]').forEach(th => {
        th.addEventListener('click', () => {
          const key = th.dataset.sort;
          if (state.sortKey === key) state.sortDir = -state.sortDir; else { state.sortKey = key; state.sortDir = 1; }
          render();
        });
      });

      const colMenu = document.getElementById('colMenu');
      const colToggleBtn = document.getElementById('colToggleBtn');
      colMenu.innerHTML = columns.map(c => {
        const checked = !state.hiddenCols.has(c.key);
        return `<label class="flex items-center gap-2 px-2 py-1.5 rounded-lg hover:bg-gray-50 cursor-pointer text-sm">
          <input type="checkbox" data-colkey="${c.key}" ${checked ? 'checked' : ''} class="accent-[#1890ff]"><span class="text-gray-700">${c.label}</span></label>`;
      }).join('');
      colMenu.querySelectorAll('input[data-colkey]').forEach(cb => {
        cb.addEventListener('change', () => {
          if (cb.checked) state.hiddenCols.delete(cb.dataset.colkey); else state.hiddenCols.add(cb.dataset.colkey);
          render();
        });
      });
      colToggleBtn.addEventListener('click', (e) => { e.stopPropagation(); colMenu.classList.toggle('hidden'); });
      document.addEventListener('click', (e) => { if (!document.getElementById('colToggleWrap').contains(e.target)) colMenu.classList.add('hidden'); });

      document.getElementById('exportBtn').addEventListener('click', () => {
        const rows = filteredStocks();
        const headers = ['代码', '名称', '连板', '涨停原因', '价格', '涨幅%', '首次涨停', '最后涨停', '开板次数', '板块'];
        const esc = v => `"${String(v == null ? '' : v).replace(/"/g, '""')}"`;
        const lines = rows.map(s => [s.stock_code, s.stock_name, toDays(s.limit_up_days), s.surge_reason, s.price, s.change_percent, s.first_limit_up, s.last_limit_up, s.break_limit_up_times, (s.plates || '').split(',').map(p => p.trim()).filter(Boolean).join('、')].map(esc).join(','));
        const csv = '\ufeff' + [headers.map(esc).join(','), ...lines].join('\n');
        const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = `涨停明细_${new Date().toISOString().split('T')[0]}.csv`;
        a.click();
        URL.revokeObjectURL(a.href);
      });

      render();
    }
  </script>
</Layout>
